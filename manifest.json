{
  "manifest_version": 3,
  "name": "Tab Stack",
  "version": "1.0",
  "description": "Group and navigate tabs by domain or custom stacks",
  "permissions": ["tabs", "storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Stack"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "push-domain": {
      "suggested_key": {
        "mac": "Alt+Shift+S",
        "windows": "Alt+Shift+S"
      },
      "description": "Push current domain tab stack"
    },
    "_execute_action": {
      "suggested_key": {
        "mac": "Alt+Shift+D",
        "windows": "Alt+Shift+D"
      }
    }
  }
}
